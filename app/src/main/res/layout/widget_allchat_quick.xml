<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_swiss"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="ALLCHAT // QUICK ASK"
            android:textColor="#111111"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxWidth="130dp"
            android:singleLine="true"
            android:text="BYOK"
            android:textColor="#FF3B30"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_ask"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/widget_btn_outline"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="ASK ANYTHING..."
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_btn_voice"
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_accent"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="MIC"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_camera"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_outline"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="CAM"
            android:textColor="#111111"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_image"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_outline"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="IMG"
            android:textColor="#111111"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Inline Direct-on-Widget Q&A Panel -->
    <LinearLayout
        android:id="@+id/widget_answer_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_outline"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_question_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="Q // "
            android:textColor="#555555"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_answer_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:maxLines="14"
            android:text=""
            android:textColor="#111111"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_outline"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="COPY"
                android:textColor="#111111"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_btn_outline"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="CLEAR"
                android:textColor="#FF3B30"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
